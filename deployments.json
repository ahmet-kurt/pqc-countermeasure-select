{
  "about": "Deployments of the paper. Times are in seconds and memory in bytes, whereas R_o is in operations per second and B_r in bytes per second. L_k is two years, the largest cryptoperiod recommended for a static decapsulation key in the draft SP 800-57 Part 1 Rev. 6.",
  "deployments": [
    {
      "name": "gateway",
      "label": "substation gateway behind site controls",
      "operation": "decaps",
      "A": "A1",
      "S": "S1",
      "chosen_inputs": true,
      "fault": false,
      "key_usage": "static",
      "L_k": 63072000,
      "R_o": 0.0166666667,
      "clock_hz": 100000000.0,
      "B_c": 0.05,
      "B_m": 65536,
      "B_r": 4000000,
      "rng": "trng",
      "weights": {
        "c": 0.5,
        "m": 0.25,
        "r": 0.25
      },
      "expect": "L1+L5 [pqm4_m4fstack]"
    },
    {
      "name": "smart_meter",
      "label": "smart meter with a static key-transport key",
      "operation": "decaps",
      "A": "A2",
      "S": "S1",
      "chosen_inputs": true,
      "fault": false,
      "key_usage": "static",
      "L_k": 63072000,
      "R_o": 0.0011111111,
      "clock_hz": 80000000.0,
      "B_c": 0.5,
      "B_m": 65536,
      "B_r": 1000000,
      "rng": "trng",
      "weights": {
        "c": 0.5,
        "m": 0.25,
        "r": 0.25
      },
      "expect": "ESCALATE(coverage)",
      "expect_designs": {
